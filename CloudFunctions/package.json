{
  "name": "garage-cloud-functions",
  "private": true,
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "deploy": "firebase deploy --only functions",
    "serve": "firebase emulators:start --only functions",
    "test": "vitest run tests/*.test.ts",
    "test:rules": "firebase --config firebase.rules-test.json --project garage-rules-test emulators:exec --only firestore,storage \"vitest run tests/rules\""
  },
  "dependencies": {
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^6.6.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "firebase-tools": "^15.23.0",
    "typescript": "^5.4.5",
    "vitest": "^4.1.10"
  }
}
