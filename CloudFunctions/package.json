{
  "name": "garage-cloud-functions",
  "private": true,
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "deploy": "firebase deploy --only functions",
    "serve": "firebase emulators:start --only functions",
    "eval:askgarage": "npx --yes tsx scripts/askGarageGoldenEval.ts",
    "test": "vitest run tests/*.test.ts",
    "test:rules": "firebase --config firebase.rules-test.json --project garage-rules-test emulators:exec --only firestore,storage \"vitest run tests/rules\""
  },
  "dependencies": {
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^6.6.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "firebase-tools": "^15.32.1",
    "typescript": "^5.4.5",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "google-gax": {
      "uuid": "^11.1.1"
    },
    "teeny-request": {
      "uuid": "^11.1.1"
    },
    "gaxios": {
      "uuid": "^11.1.1"
    },
    "@google-cloud/pubsub": {
      "@opentelemetry/core": "^2.8.0"
    },
    "@modelcontextprotocol/sdk": {
      "@hono/node-server": "^2.0.5"
    },
    "brace-expansion": "^5.0.8"
  }
}
